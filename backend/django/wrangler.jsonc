{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "mavis-fantasy-grinder-api",
  "main": "worker/mavis-container-proxy.mjs",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DJANGO_ALLOWED_HOSTS": "localhost,127.0.0.1,.workers.dev,.mavis-fantasy-grinder.pages.dev,*",
    "CORS_ALLOWED_ORIGINS": "https://mavis-fantasy-grinder.pages.dev,http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173"
  }
}
